#!/usr/bin/env python3
"""Install Deep Tutor OpenCode plugin into a leveling workspace or globally."""

from __future__ import annotations

import argparse
import os
import shutil
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PLUGIN_SOURCE = REPO_ROOT / ".opencode" / "plugins" / "deep-tutor.js"
GLOBAL_PLUGIN_DIR = Path.home() / ".config" / "opencode" / "plugins"


def fail(message: str) -> int:
    print(f"opencode-install: {message}", file=sys.stderr)
    return 1


def symlink_plugin(target_dir: Path) -> Path:
    target_dir.mkdir(parents=True, exist_ok=True)
    link_path = target_dir / "deep-tutor.js"
    if link_path.is_symlink():
        if link_path.resolve() == PLUGIN_SOURCE.resolve():
            return link_path
        link_path.unlink()
    elif link_path.exists():
        raise FileExistsError(f"refusing to overwrite existing file: {link_path}")
    link_path.symlink_to(PLUGIN_SOURCE.resolve())
    return link_path


def write_example_config(target: Path) -> Path | None:
    example = REPO_ROOT / "integration" / "opencode" / "opencode.json.example"
    config_path = target / "opencode.json"
    if config_path.exists():
        return None
    if not example.is_file():
        return None
    shutil.copy2(example, config_path)
    return config_path


def install_project(target: Path) -> int:
    if not PLUGIN_SOURCE.is_file():
        return fail(f"missing plugin source: {PLUGIN_SOURCE}")

    plugin_dir = target / ".opencode" / "plugins"
    try:
        link_path = symlink_plugin(plugin_dir)
    except FileExistsError as exc:
        return fail(str(exc))

    config_path = write_example_config(target)
    print("opencode-install: OK (project)")
    print(f"  target: {target.resolve()}")
    print(f"  plugin: {link_path} -> {PLUGIN_SOURCE.resolve()}")
    if config_path:
        print(f"  config: {config_path} (new)")
    print()
    print("Set in your shell (or leveling README) if auto-detect fails:")
    print(f"  export DEEP_TUTOR_ROOT={REPO_ROOT.resolve()}")
    print()
    print("Start OpenCode from a domain or project folder under this workspace.")
    return 0


def install_global() -> int:
    if not PLUGIN_SOURCE.is_file():
        return fail(f"missing plugin source: {PLUGIN_SOURCE}")

    try:
        link_path = symlink_plugin(GLOBAL_PLUGIN_DIR)
    except FileExistsError as exc:
        return fail(str(exc))

    print("opencode-install: OK (global)")
    print(f"  plugin: {link_path} -> {PLUGIN_SOURCE.resolve()}")
    print()
    print("Add to your shell profile:")
    print(f"  export DEEP_TUTOR_ROOT={REPO_ROOT.resolve()}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Install Deep Tutor OpenCode plugin (Integration milestone).",
    )
    parser.add_argument(
        "--target",
        type=Path,
        default=None,
        help="Leveling workspace root (default: sibling leveling-arc or DEEP_TUTOR_LEVELING_ROOT)",
    )
    parser.add_argument(
        "--global",
        dest="global_install",
        action="store_true",
        help="Install to ~/.config/opencode/plugins/",
    )
    return parser


def default_target() -> Path | None:
    env = os.environ.get("DEEP_TUTOR_LEVELING_ROOT")
    if env:
        path = Path(env).expanduser()
        if path.is_dir():
            return path

    sibling = REPO_ROOT.parent / "leveling-arc"
    if sibling.is_dir():
        return sibling
    return None


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    if args.global_install:
        return install_global()

    target = args.target
    if target is None:
        target = default_target()
    if target is None:
        return fail(
            "provide --target PATH to your leveling workspace, "
            "or set DEEP_TUTOR_LEVELING_ROOT"
        )
    if not target.is_dir():
        return fail(f"target is not a directory: {target}")

    return install_project(target.expanduser().resolve())


if __name__ == "__main__":
    raise SystemExit(main())
