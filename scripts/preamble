#!/usr/bin/env python3
"""Print an inspectable Deep Tutor preamble for the current cwd."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

import json

from orchestrator.assemble import assemble_preamble, default_mode_and_hint  # noqa: E402
from orchestrator.bind import bind_context, repo_root_from_module  # noqa: E402
from orchestrator.opencode import build_opencode_context  # noqa: E402
from orchestrator.routing import (  # noqa: E402
    format_routing_summary,
    log_routing_decision,
    route,
)


def build_parser() -> argparse.ArgumentParser:
    default_mode, default_hint = default_mode_and_hint(REPO_ROOT)

    parser = argparse.ArgumentParser(
        description="Emit an inspectable Deep Tutor preamble for OpenCode.",
    )
    parser.add_argument(
        "--cwd",
        type=Path,
        default=None,
        help="Directory to bind (default: process cwd)",
    )
    parser.add_argument(
        "--domain",
        metavar="KEY",
        default=None,
        help="Override domain key (e.g. dsa, system-design)",
    )
    parser.add_argument(
        "--leveling-root",
        metavar="PATH",
        default=None,
        help="Path to leveling workspace (overrides config and auto-detect)",
    )
    parser.add_argument(
        "--message",
        "-m",
        default=None,
        help="User utterance; auto-select teach mode via routing v1",
    )
    parser.add_argument(
        "--mode",
        choices=("mentor", "debug", "concept"),
        default=None,
        help=f"Teaching mode prompt pack (default: {default_mode}, or routed)",
    )
    parser.add_argument(
        "--hint-level",
        type=int,
        choices=range(1, 6),
        default=default_hint,
        metavar="N",
        help=f"Hint ceiling 1–5 (default: {default_hint})",
    )
    parser.add_argument(
        "--binding-only",
        action="store_true",
        help="Print binding metadata only, not the full preamble",
    )
    parser.add_argument(
        "--route-only",
        action="store_true",
        help="Print routing summary only (requires --message)",
    )
    parser.add_argument(
        "--no-routing-log",
        action="store_true",
        help="Do not append routing decision to routing.jsonl",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit machine-readable JSON (same payload as opencode-hook)",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    repo_root = repo_root_from_module()

    binding = bind_context(
        repo_root=repo_root,
        cwd=args.cwd,
        domain_flag=args.domain,
        leveling_root_override=args.leveling_root,
    )

    if args.binding_only:
        leveling = binding.leveling_root or "—"
        print(f"cwd: {binding.cwd}")
        print(f"leveling_root: {leveling}")
        print(f"domain: {binding.domain} (source: {binding.domain_source})")
        print(f"project: {binding.project or '—'}")
        print(f"curated_context: {'yes' if binding.curated_context else 'no'}")
        return 0

    routing_decision = None
    mode = args.mode
    if args.message and not args.json:
        routing_decision = route(args.message, binding=binding)
        if mode is None:
            mode = routing_decision.mode
        if not args.no_routing_log:
            log_routing_decision(
                routing_decision,
                utterance=args.message,
                repo_root=repo_root,
                binding=binding,
            )
        if args.route_only:
            print(format_routing_summary(routing_decision))
            return 0

    if args.json:
        payload = build_opencode_context(
            repo_root,
            cwd=binding.cwd,
            message=args.message,
            domain=args.domain,
            leveling_root=args.leveling_root,
            mode=mode,
            hint_level=args.hint_level,
            log_routing=bool(args.message) and not args.no_routing_log,
        )
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    if mode is None:
        mode, _ = default_mode_and_hint(repo_root)

    preamble = assemble_preamble(
        binding,
        mode=mode,
        hint_level=args.hint_level,
        routing=routing_decision,
    )
    sys.stdout.write(preamble.text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
