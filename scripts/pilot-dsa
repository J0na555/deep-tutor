#!/usr/bin/env python3
"""End-to-end smoke check for Workflow A (DSA domain pilot)."""

from __future__ import annotations

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from orchestrator.assemble import assemble_preamble  # noqa: E402
from orchestrator.bind import bind_context, repo_root_from_module, resolve_leveling_root  # noqa: E402

EXPECTED_DOMAIN = "dsa"
EXPECTED_FOCUS_SNIPPETS = (
    "Arrays & two pointers",
    "Complexity habits",
    "reasoning and complexity awareness",
    "Avoid full solutions early",
)


def fail(message: str) -> int:
    print(f"pilot-dsa: FAIL — {message}", file=sys.stderr)
    return 1


def main() -> int:
    repo_root = repo_root_from_module()
    leveling_root = resolve_leveling_root(repo_root, repo_root)
    if leveling_root is None:
        return fail(
            "leveling-arc not found (expected sibling with domains/ and projects/). "
            "Set DEEP_TUTOR_LEVELING_ROOT or configs/default.json leveling_root."
        )

    dsa_cwd = leveling_root / "domains" / EXPECTED_DOMAIN
    if not dsa_cwd.is_dir():
        return fail(f"missing {dsa_cwd}")

    context_path = dsa_cwd / "CONTEXT.md"
    if not context_path.is_file():
        return fail(f"missing {context_path} (Workflow A curated context)")

    binding = bind_context(repo_root=repo_root, cwd=dsa_cwd)
    if binding.domain != EXPECTED_DOMAIN:
        return fail(f"expected domain {EXPECTED_DOMAIN!r}, got {binding.domain!r}")
    if binding.domain_source != "path":
        return fail(f"expected domain_source 'path', got {binding.domain_source!r}")
    if binding.leveling_root != leveling_root.resolve():
        return fail("leveling_root mismatch on binding")
    if not binding.curated_context:
        return fail("curated_context empty (CONTEXT.md should load)")

    preamble = assemble_preamble(binding, mode="mentor", hint_level=2)
    text = preamble.text

    for snippet in EXPECTED_FOCUS_SNIPPETS:
        if snippet not in text:
            return fail(f"preamble missing expected snippet: {snippet!r}")

    if "Curated domain context" not in text:
        return fail("preamble missing curated context section")

    print("pilot-dsa: OK")
    print(f"  leveling_root: {leveling_root}")
    print(f"  cwd: {dsa_cwd}")
    print(f"  domain: {binding.domain} (source: {binding.domain_source})")
    print(f"  curated_context: {len(binding.curated_context)} chars from CONTEXT.md")
    print(f"  preamble: {len(text)} chars, sources: {', '.join(preamble.sources)}")
    print()
    print("Next (Workflow A):")
    print(f"  cd {dsa_cwd}")
    print("  # start OpenCode, then:")
    print(f"  {REPO_ROOT / 'scripts' / 'preamble'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
